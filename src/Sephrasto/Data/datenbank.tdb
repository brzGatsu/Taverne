&lt;td align="center"&gt;20&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fischen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;Wasser suchen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;28&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;&amp;nbsp;&lt;/td&gt;
&lt;td&gt;&amp;nbsp;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; giftige Tiere und Pflanzen (Waldwebe, Boronsschlinge, Disdychonda, Trichterwurzel), Raubtiere, Maraskantarantel, Maraskanfeder, asfalothische Zonen, Heerbann-Zonen, Achaz, Dämonenkulte, Krabbeltiere.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
