&lt;/tr&gt;
&lt;tr height="24px"&gt;
    &lt;td style="font-variant: small-caps;"&gt;&lt;b&gt;Nahrung&lt;/b&gt;&lt;/td&gt;
    &lt;td align="center"&gt;&lt;/td&gt;
    &lt;td&gt;&lt;b&gt;/&lt;/b&gt;&lt;/td&gt;
