&lt;/tr&gt;
&lt;tr height="24px"&gt;
    &lt;td style="font-variant: small-caps;"&gt;&lt;b&gt;Fackeln&lt;/b&gt;&lt;/td&gt;
    &lt;td align="center"&gt;&lt;/td&gt;
