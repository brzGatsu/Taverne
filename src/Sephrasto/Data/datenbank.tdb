&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;24&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;&amp;nbsp;&lt;/td&gt;
&lt;td&gt;&amp;nbsp;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; Raubtiere, giftige Tiere (Schlangen, Spinnen) und Pflanzen (Waldwebe, Boronsschlinge, Disdychonda), Insekten, Raubkatzen, Waldmenschen (insb. bei Tabuzonen, da auch Totengeister oder Dämonen), Achazstämme.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Eiswüste" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;Im Hohen Norden liegt das Ewige Eis.&lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima: &lt;/b&gt;&lt;i&gt;Eiskalte &lt;/i&gt;Temperatur im Sommer, Frühling und Herbst, &lt;i&gt;Firunsfrost&lt;/i&gt; im Winter. Nachts 1 Stufe kälter.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Sicht: &lt;/b&gt;Im Ewigen Eis dauern die Tage im Winter kürzer, je weiter nördlich man kommt, umgekehrt im Sommer.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Untergrund: &lt;/b&gt;Eis und Schnee. Keine Fahrzeuge. Mit Schneeschuhen und Skiern &lt;i&gt;unsicher&lt;/i&gt;, mit Hundeschlitten &lt;i&gt;sicher&lt;/i&gt;.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Straße&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Pfad&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Weg&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Querfeldein&lt;/td&gt;
&lt;td align="center"&gt;schwierig&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Nahrungsbeschaffung&lt;/b&gt;&lt;/td&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Überleben&lt;/b&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
