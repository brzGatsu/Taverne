  <Karte name="Südmeerinseln" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;&lt;i&gt;Nur im Tiefen Süden. Entspricht je nach Insel der Landschaft Dschungel, Savanne oder Gebirge.&lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;&lt;b&gt;Klima:&lt;/b&gt; Wechselfeuchtes Klima. &lt;i&gt;Normale &lt;/i&gt;Temperatur in der Regenzeit, auch in der Nacht. &lt;i&gt;Warm&lt;/i&gt; in der Trockenzeit.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;&lt;b&gt;Weitere Gefahren:&lt;/b&gt; Einsamkeit, Raubtiere, feindliche Eingeborene, Würgedattel (zwischen Altoum und Ibonka)&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
