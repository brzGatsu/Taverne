&lt;td align="center"&gt;16&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;28&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;32&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;28&lt;/td&gt;
&lt;td&gt;&lt;b&gt;Winter&lt;/b&gt;&lt;/td&gt;
&lt;td align="center"&gt;+4&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; Kälte, Hunger, Raubtiere, Schneeblindheit, Lawinen, Schneewechte, bodenlose Gletscherspalten, Yetis, Weißpelzorks, Schneegoblins, Firnelfen, Fjarninger; Schwarzfrostwüste: Nagrachs Hauch.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Gebirge" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;Mittelgebirge in ganz Aventurien.&lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima: &lt;/b&gt;&lt;i&gt;Kühle&lt;/i&gt; Temperatur im Sommer, &lt;i&gt;kalt&lt;/i&gt; im Frühling, Herbst und Winter. Nachts 1 Stufe kälter.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Untergrund:&lt;/b&gt; Steil und geröllig. Fahrzeuge nur auf Straße und Weg mit langsamem Marsch. Querfeldein beritten nur mit langsamem Marsch.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Straße&lt;/td&gt;
&lt;td align="center"&gt;unsicher&lt;/td&gt;
&lt;td&gt;Pfad&lt;/td&gt;
&lt;td align="center"&gt;schwierig&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Weg&lt;/td&gt;
&lt;td align="center"&gt;unsicher&lt;/td&gt;
&lt;td&gt;Querfeldein&lt;/td&gt;
&lt;td align="center"&gt;schwierig&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Nahrungsbeschaffung&lt;/b&gt;&lt;/td&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Überleben&lt;/b&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fallenstellen&lt;/td&gt;
&lt;td align="center"&gt;20&lt;/td&gt;
&lt;td&gt;Lager bereiten&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fischen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;Wasser suchen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;&lt;b&gt;Winter&lt;/b&gt;&lt;/td&gt;
&lt;td align="center"&gt;+4&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; wilde Tiere, plötzliche Wetterumschwünge, Trolle, Trollzacker, Goblins, Orks, Oger, Grolme, Greifvögel, Drachen, Harpyien; Maraskan: Jagdgras.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Gewässer" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;Meere, Seen und Flüsse in ganz Aventurien.&lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima: &lt;/b&gt;Je nach Region und Jahreszeit.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4" style="border-bottom: 1px solid #4A000B;"&gt;&lt;b&gt;Untergrund:&lt;/b&gt; Schwankend. &lt;i&gt;Unsicher&lt;/i&gt; bei &lt;i&gt;schlechtem&lt;/i&gt; Wetter, &lt;i&gt;schwierig&lt;/i&gt; bei &lt;i&gt;miserablem&lt;/i&gt; Wetter – sowohl für das Schiff als auch die Mannschaft, &lt;i&gt;schwierig&lt;/i&gt; bei Fahrt flussaufwärts.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Nahrungsbeschaffung&lt;/b&gt;&lt;/td&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Seefahrt&lt;/b&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fallenstellen&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td colspan="2"&gt;Wildnisführung&amp;nbsp;(Steuern/Nav.)&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fischen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;    In Landnähe&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;    Hochsee&lt;/td&gt;
&lt;td align="center"&gt;36&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;&amp;nbsp;&lt;/td&gt;
&lt;td align="center"&gt;&amp;nbsp;&lt;/td&gt;
&lt;/tr&gt;
&lt;td colspan="4" style="border-bottom: 1px solid #4A000B;"&gt;&lt;b&gt;Besonderheiten:&lt;/b&gt; Ein Schiff ist ein &lt;i&gt;sicherer Ort&lt;/i&gt; und es gibt genügend Vorräte, sodass normalerweise keine aufbauenden Aktionen verwendet werden. Trinkwasser gibt es nur in Seen oder Flüssen. Außer Feuerschlick (elburische Küste) und Sansaro (zwischen Selem und Charypso) gibt es keine nennenswerten Pflanzen im offenen Meer.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; Sturm, Hunger, Durst, viele Personen auf kleinem Raum, Piraten, Geisterschiffe, Krakenmolche, Seeschlangen, charyptoide Wesenheiten (z.B. Dämonenarchen).&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Grasland &amp; Heide" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;Relativ ungefährliche Steppen- und Hügellandschaft, durchzogen von Flüssen. Vor allem in Mittelaventurien und im westlichen Südaventurien.&lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima: &lt;/b&gt;&lt;i&gt;Normale&lt;/i&gt; Temperatur in jeder Jahreszeit. In Mittelaventurien &lt;i&gt;kühl&lt;/i&gt; im Winter. Nachts 1 Stufe kälter.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Untergrund: &lt;/b&gt;Grundsätzlich &lt;i&gt;sicher&lt;/i&gt;.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Straße&lt;/td&gt;
&lt;td align="center"&gt;sicher&lt;/td&gt;
&lt;td&gt;Pfad&lt;/td&gt;
&lt;td align="center"&gt;sicher&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Weg&lt;/td&gt;
&lt;td align="center"&gt;sicher&lt;/td&gt;
&lt;td&gt;Querfeldein&lt;/td&gt;
&lt;td align="center"&gt;sicher&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Nahrungsbeschaffung&lt;/b&gt;&lt;/td&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Überleben&lt;/b&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fallenstellen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;Lager bereiten&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fischen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;Wasser suchen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;&lt;b&gt;Winter&lt;/b&gt;&lt;/td&gt;
&lt;td align="center"&gt;+4&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; wilde Tiere, feindliche Einwohner, Raubtiere, Räuberbanden (je nach Region Yurach, verarmte Menschen oder Goblins, auch gemischt), Oger, Grüne Schleimschlange; Tobrien: Schwarmschwamm.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Hochgebirge" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;In der Regel oberhalb von 2000 Schritt in ganz Aventurien. &lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima: &lt;/b&gt;&lt;i&gt;Kalte&lt;/i&gt; Temperatur im Sommer, &lt;i&gt;eiskalt&lt;/i&gt; im Frühling, Herbst und Winter. Nachts 1 Stufe kälter. Ab 6000 Schritt 1 Stufe kälter.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Untergrund: &lt;/b&gt;Steil und geröllig. Keine Fahrzeuge. Querfeldein beritten nur mit langsamem Marsch.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Straße&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Pfad&lt;/td&gt;
&lt;td align="center"&gt;schwierig&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Weg&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Querfeldein&lt;/td&gt;
&lt;td align="center"&gt;schwierig&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Nahrungsbeschaffung&lt;/b&gt;&lt;/td&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Überleben&lt;/b&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fallenstellen&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Lager bereiten&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fischen&lt;/td&gt;
&lt;td align="center"&gt;24&lt;/td&gt;
&lt;td&gt;Wasser suchen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;20&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;24&lt;/td&gt;
&lt;/tr&gt;
&lt;tr  style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;24&lt;/td&gt;
&lt;td&gt;&lt;b&gt;Winter&lt;/b&gt;&lt;/td&gt;
&lt;td align="center"&gt;+4&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; Absturz, Lawinen, plötzliche Wetterumschwünge, Drachen, Yetis, Frostwürmer, Greife, Sturm-/Bergriesen (Legende), Sauerstoffmangel ab 4000 Schritt.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Höhlen" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;Höhlen jeder Größe in ganz Aventurien. Im Gebirge nicht selten eine (verlassene) Zwergenmine.&lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima: &lt;/b&gt;Keine Jahreszeiten. &lt;i&gt;Kühle &lt;/i&gt;Temperatur in jeder Jahreszeit, auch in der Nacht.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Sicht: &lt;/b&gt;Immer &lt;i&gt;miserabel&lt;/i&gt; durch Dunkelheit.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Untergrund: &lt;/b&gt;Je nach Höhle steil, geröllig, rutschig. Nur zu Fuß. Je nach Höhle &lt;i&gt;normaler&lt;/i&gt; bis &lt;i&gt;schwieriger&lt;/i&gt; Untergrund.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Nahrungsbeschaffung&lt;/b&gt;&lt;/td&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Überleben&lt;/b&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fallenstellen&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Lager bereiten&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fischen&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Wasser suchen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;32&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;28&lt;/td&gt;
&lt;td&gt;&amp;nbsp;&lt;/td&gt;
&lt;td&gt;&amp;nbsp;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Besonderheiten: &lt;/b&gt;Außer Phosphorpilz (Orkland, Finsterkamm) und den gefährlichen Efeuer, Feuermoos und Efferdmoos gibt es keine nennenswerten Pflanzen in Höhlen.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; feindliche Bewohner, Einsturz, Höhlenspinnen, Gruftasseln, Riesenamöben, Felsschrate, Tiefzwerge, Geister von Verstorbenen, Wachgolems, Elementare und Gargyle.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Lichter Wald" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;Vor allem in Süd-, Mittel- und Nordaventurien und im Hohen Norden. &lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima:&lt;/b&gt; &lt;i&gt;Normale &lt;/i&gt;Temperatur in jeder Jahreszeit. In Mittelaventurien &lt;i&gt;kühl&lt;/i&gt; im Winter. Je nach Region ist jede Jahreszeit 1 (Nordaventurien) bzw. 2 (Hohen Norden) Stufen kälter. Nachts 1 Stufe kälter.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Untergrund: &lt;/b&gt;Etwas Unterholz. Pfad und Querfeldein mit Fahrzeug nur mit langsamem Marsch.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Straße&lt;/td&gt;
&lt;td align="center"&gt;sicher&lt;/td&gt;
&lt;td&gt;Pfad&lt;/td&gt;
&lt;td align="center"&gt;sicher&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Weg&lt;/td&gt;
&lt;td align="center"&gt;sicher&lt;/td&gt;
&lt;td&gt;Querfeldein&lt;/td&gt;
&lt;td align="center"&gt;unsicher&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Nahrungsbeschaffung&lt;/b&gt;&lt;/td&gt;
&lt;td colspan="2"&gt;&lt;b&gt;Überleben&lt;/b&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fallenstellen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;Lager bereiten&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Fischen&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;td&gt;Wasser suchen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Jagen&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;Wildnisführung&lt;/td&gt;
&lt;td align="center"&gt;16&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td&gt;Sammeln&lt;/td&gt;
&lt;td align="center"&gt;12&lt;/td&gt;
&lt;td&gt;&lt;b&gt;Winter&lt;/b&gt;&lt;/td&gt;
&lt;td align="center"&gt;+4&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Gefahren:&lt;/b&gt; Raubtiere, räuberische Bewohner, Efeuer, Waldwebe; Orkland: Basilamine, Orkland-Bovist; Südlich: Boronsschlinge; Tobrien: Tuur-Amasch-Kelch.&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</Karte>
  <Karte name="Maraskanischer Dschungel" voraussetzungen="" typ="5" subtyp="Wildnisreisen" titel="$original$" subtitel="$original$" fusszeile="Landschaft" löschen="0">&lt;table&gt;
&lt;tr style="border-bottom: 1px solid #4A000B;"&gt;
&lt;td colspan="4"&gt;&lt;i&gt;Auf Maraskan lauert der Tod hinter jeder Ecke, nicht einmal Wasserschöpfen ist gefahrlos möglich.&lt;/i&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Klima:&lt;/b&gt; Wechselfeuchtes Klima mit Regenzeit nur im Phex und Rondra. &lt;i&gt;Normale &lt;/i&gt;Temperatur in der Regenzeit, auch in der Nacht. &lt;i&gt;Warm&lt;/i&gt; in der Trockenzeit. &lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Sicht:&lt;/b&gt; &lt;i&gt;Schlecht&lt;/i&gt; bis &lt;i&gt;miserabel&lt;/i&gt; durch Bewuchs.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="4"&gt;&lt;b&gt;Untergrund:&lt;/b&gt; Dichtes Unterholz. Keine Fahrzeuge.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Straße&lt;/td&gt;
&lt;td align="center"&gt;-&lt;/td&gt;
&lt;td&gt;Pfad&lt;/td&gt;
